{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acos.local/schema/ws13_messages.schema.json",
  "title": "ACOS WS13 signed UI message envelope",
  "description": "Remote-first GUI message envelope. Integrity covers canonical (session_id, nonce, ts, capability_target, payload_hash); TLS alone is not sufficient.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "session_id",
    "nonce",
    "ts",
    "capability_target",
    "payload_hash",
    "payload",
    "signature"
  ],
  "properties": {
    "version": {
      "const": "ws13.v1"
    },
    "kind": {
      "type": "string",
      "enum": [
        "event.subscribe",
        "event.snapshot",
        "action.request",
        "action.result",
        "error"
      ]
    },
    "session_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "nonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "ts": {
      "description": "Unix timestamp in milliseconds, generated by the envelope signer.",
      "type": "integer",
      "minimum": 0
    },
    "capability_target": {
      "$ref": "#/$defs/capability_target"
    },
    "payload_hash": {
      "description": "sha256 hex digest of the canonical JSON payload bytes.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload": {
      "description": "Message body. It is intentionally typed by kind/action modules, not by this integrity envelope.",
      "type": "object"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "capability_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "operation"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "ObservabilityRead",
            "GuardianRead",
            "UiActionRequest",
            "UiActionResult",
            "None"
          ]
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "resource": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_./:-]*$"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "key_id",
        "value"
      ],
      "properties": {
        "alg": {
          "type": "string",
          "enum": [
            "HMAC-SHA256",
            "ED25519"
          ]
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "value": {
          "description": "Base64url signature over canonical (session_id, nonce, ts, capability_target, payload_hash).",
          "type": "string",
          "minLength": 43,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+={0,2}$"
        }
      }
    }
  }
}
